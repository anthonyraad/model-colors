{
  "name": "model-cycles-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop companion for the Elektron Model:Cycles. This version connects over MIDI and sends live parameter changes.",
  "main": "./out/main/index.js",
  "type": "module",
  "dependencies": {
    "@julusian/midi": "^3.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "rebuild:midi": "electron-rebuild -f -w @julusian/midi",
    "pack": "electron-vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "local.model-cycles-editor",
    "productName": "Model:Colors",
    "executableName": "Model：Colors",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/@julusian/midi/**"
    ],
    "extraResources": [
      {
        "from": "host/publish/CyclesInsertHost.exe",
        "to": "insert-host/CyclesInsertHost.exe"
      },
      {
        "from": "build/icon-face.png",
        "to": "icon-face.png"
      },
      {
        "from": "build/splash.html",
        "to": "splash.html"
      },
      {
        "from": "build/splash.png",
        "to": "splash.png"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Model：Colors.${ext}"
    }
  },
  "allowScripts": {
    "@julusian/midi@3.8.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
